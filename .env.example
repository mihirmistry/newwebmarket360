# Copy to .env and fill in. Never commit the real .env.

# development | production
NODE_ENV=development
PORT=3000

# PostgreSQL connection string.
# For local testing without installing PostgreSQL, run `npm run db:local` and use the URL it prints.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/market360x

# Set to "true" if your Postgres host requires SSL (most managed providers do).
DATABASE_SSL=false

# Long random string used to sign session cookies (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Set to "true" when running behind a reverse proxy / load balancer that terminates HTTPS.
TRUST_PROXY=false

# Customer log in / sign up / dashboard. Off for now (plans are bought through the QR checkout).
CUSTOMER_ACCOUNTS=false

# ---------- QR checkout ----------
# By default the checkout shows the business QR in public/images/payment/qr-market360x.webp.
# Optional: set a UPI ID instead and the site draws a QR with each plan's exact amount filled in.
PAYMENT_UPI_ID=
# Payee name the customer's UPI app shows (must match the QR / UPI ID).
PAYMENT_UPI_NAME=Anand Singh
# QR image under public/ (default /images/payment/qr-market360x.webp; "none" turns it off).
PAYMENT_QR_IMAGE=

# ---------- Order emails ----------
# New orders are emailed here (they are also listed in the admin panel at /admin/orders).
ADMIN_EMAIL=
# SMTP server used to send them. Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address (defaults to SMTP_USER).
MAIL_FROM=
