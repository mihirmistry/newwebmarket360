{
  "name": "market360x",
  "version": "1.0.0",
  "private": true,
  "description": "Market360X website and Nifty market sentiment alerts (TypeScript, Node.js, PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "start": "node dist/server.js",
    "dev": "npm run build:client && tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "create-admin:prod": "node dist/scripts/create-admin.js",
    "db:local": "tsx src/scripts/local-db.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@types/compression": "1.8.1",
    "@types/connect-pg-simple": "7.0.3",
    "@types/ejs": "3.1.5",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.1",
    "@types/node": "22.10.7",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.6",
    "compression": "1.8.1",
    "connect-pg-simple": "10.0.0",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "esbuild": "0.24.2",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "helmet": "8.0.0",
    "lucide-static": "1.48.0",
    "nodemailer": "10.0.13",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "typescript": "5.7.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/supertest": "6.0.2",
    "embedded-postgres": "17.10.0-beta.17",
    "supertest": "7.0.0",
    "tsx": "4.19.2"
  }
}
