<%#
  Nifty 50 market sentiment banner: today's sentiment and alert counts (left card) and the daily trend chart.
  Rendered on the server from saved alerts, then refreshed in the browser by /js/dashboard.js
  (polls /api/nifty-sentiment). Expects locals: sentimentData (or null), fmt, renderedAt.
%>
<%
  const d = sentimentData;
  const s = d ? d.sentiment : { percent: 0, label: 'Neutral' };
  const c = d ? d.counts : { bullish: 0, bearish: 0, neutral: 0, active: 0 };
  const history = d && d.history ? d.history : [];
  const share = fmt.alertShares(c);
  const tone = s.label.toLowerCase();
%>
<section
  id="sentiment"
  class="m3x-sent2"
  aria-label="Nifty 50 market sentiment"
  data-sentiment-dashboard
  data-endpoint="/api/nifty-sentiment"
  data-poll-ms="20000"
  data-rendered-at="<%= renderedAt %>"
  data-state="<%= d ? 'ready' : 'error' %>"
>
  <!-- today: direction + alert counts -->
  <div class="m3x-sent2-score is-<%= tone %>" data-score-card>
    <div class="m3x-sent2-head">
      <span class="m3x-sent2-icon" aria-hidden="true">
        <svg class="m3x-ico-up" viewBox="0 0 24 24"><path d="M22 7 13.5 15.5 8.5 10.5 2 17" /><path d="M16 7h6v6" /></svg>
        <svg class="m3x-ico-down" viewBox="0 0 24 24"><path d="M22 17 13.5 8.5 8.5 13.5 2 7" /><path d="M16 17h6v-6" /></svg>
        <svg class="m3x-ico-flat" viewBox="0 0 24 24"><path d="M5 12h14" /></svg>
      </span>
      <div class="m3x-sent2-headtext">
        <span class="m3x-sent2-kicker">Overall Sentiment</span>
        <strong class="m3x-sent2-label" data-label><%= s.label %></strong>
      </div>
      <strong class="m3x-sent2-percent" data-percent><%= fmt.formatPercent(s.percent) %></strong>
    </div>
    <ul class="m3x-sent2-counts" aria-label="Alerts by direction">
      <li class="is-bullish"><i aria-hidden="true"></i><span>Bullish alerts</span><b data-count="bullish"><%= c.bullish %></b><em data-share="bullish"><%= share.bullish %>%</em></li>
      <li class="is-bearish"><i aria-hidden="true"></i><span>Bearish alerts</span><b data-count="bearish"><%= c.bearish %></b><em data-share="bearish"><%= share.bearish %>%</em></li>
      <li class="is-neutral"><i aria-hidden="true"></i><span>Neutral alerts</span><b data-count="neutral"><%= c.neutral %></b><em data-share="neutral"><%= share.neutral %>%</em></li>
    </ul>
    <p class="m3x-sent2-total"><b data-count="active"><%= c.active %></b> active alerts</p>
  </div>

  <!-- daily trend -->
  <figure class="m3x-trend" aria-label="Overall sentiment over recent days">
    <figcaption class="m3x-trend-cap">Sentiment trend
      <div class="m3x-trend-meta">
        <span data-trend-range>Last <%= Math.max(history.length, 1) %> day<%= history.length === 1 ? "" : "s" %></span>
        <%# the active indicators and their values, on hover / focus / tap (kept current by /js/dashboard.js) %>
        <div class="m3x-ind" data-ind>
          <button type="button" class="m3x-ind-btn" aria-label="Show the active indicators and their values" aria-expanded="false" aria-controls="m3x-ind-pop" data-ind-btn>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
          </button>
          <div class="m3x-ind-pop" id="m3x-ind-pop" data-ind-pop>
            <p class="m3x-ind-title">Active indicators</p>
            <ul class="m3x-ind-list" data-ind-list>
              <% (d ? d.alerts : []).forEach(function (a) { %><li class="is-<%= a.direction.toLowerCase() %>"><strong><%= a.name %></strong><b><%= fmt.formatSignal(a.signalValue) %></b></li>
              <% }) %><% if (!d || !d.alerts.length) { %><li class="is-empty">No active indicators</li><% } %>
            </ul>
            <p class="m3x-ind-key">+1 bullish &middot; 0 neutral &middot; &minus;1 bearish</p>
          </div>
        </div>
      </div>
    </figcaption>
    <div class="m3x-trend-chart" data-trend><%- fmt.trendChartHtml(history) %></div>
    <p class="m3x-trend-note"><span class="m3x-trend-dot" aria-hidden="true"></span><span data-updated><% if (d) { %>Last updated <%= fmt.formatIstDateTime(d.updatedAt) %><% } %></span></p>
  </figure>

  <p class="m3x-sent2-error" data-error role="alert" <%= d ? 'hidden' : '' %>>
    <% if (!d) { %>We couldn't load the latest alerts. Retrying automatically&hellip;<% } %>
  </p>
</section>
