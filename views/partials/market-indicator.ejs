<%#
  Header "Market ±N%" badge. Server-rendered from saved alerts (local: headerSentiment, may be missing),
  then kept fresh in the browser by /js/dashboard.js (homepage) or /js/indicator.js (other pages).
%>
<% const ms = typeof headerSentiment !== 'undefined' && headerSentiment ? headerSentiment : null; %>
<a
  href="/#sentiment"
  class="m3x-mkt is-<%= ms ? ms.label.toLowerCase() : 'neutral' %>"
  data-market-indicator
  aria-label="Market<%= ms ? ' ' + fmt.formatPercent(ms.percent) + ' ' + ms.label : '' %> (Nifty 50 sentiment)"
  <%= ms ? '' : 'hidden' %>
>
  <span class="m3x-mkt-label">Market</span>
  <span class="m3x-mkt-value" data-mkt-value><%= ms ? fmt.formatPercent(ms.percent) : '' %></span>
  <span class="m3x-mkt-icon" aria-hidden="true">
    <svg class="m3x-ico-up" viewBox="0 0 24 24"><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></svg>
    <svg class="m3x-ico-down" viewBox="0 0 24 24"><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></svg>
    <svg class="m3x-ico-flat" viewBox="0 0 24 24"><path d="M5 12h14" /></svg>
  </span>
  <span class="m3x-mkt-state" data-mkt-state><%= ms ? ms.label : '' %></span>
</a>
