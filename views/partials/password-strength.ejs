<%# 4-bar strength meter + rule checklist for a new-password input (driven by /js password-ui). Local: idp (id prefix). %>
        <div class="m3x-strength" data-strength="0">
          <span class="m3x-strength-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="m3x-strength-label" id="<%= idp %>-strength" data-strength-label aria-live="polite">Password strength</span>
        </div>
        <ul class="m3x-pass-rules" id="<%= idp %>-rules" aria-label="Password must have">
          <% passwordRules.forEach(function (rule) { %>
          <li data-rule="<%= rule.id %>"><%- icon('circle', 'is-todo') %><%- icon('circle-check', 'is-done') %><span><%= rule.label %></span></li>
          <% }) %>
        </ul>
