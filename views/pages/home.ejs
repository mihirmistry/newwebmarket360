<section id="how-it-works" class="m3x-sec m3x-pt-0 bg-background-6 pt-20 pb-16 md:pt-27 md:pb-20 lg:pt-33 lg:pb-26 xl:pt-39 xl:pb-28">
  <div class="main-container">
    <div class="m3x-stack">
      <div class="m3x-stack-intro">
        <h2
          data-opai-text-reveal
          data-word-delay="0.1"
          data-word-rotation-x="120"
          data-word-offset-y="50"
          class="xl:text-sora-heading-2 lg:text-sora-heading-3 text-sora-heading-4 font-normal tracking-[-2.4px] text-white/90"
        >
          We don't guess. <span class="text-mint m3x-line">We read the data.</span>
        </h2>
        <p class="m3x-stack-lead">
          Every alert is built from market data, not tips or hunches. A trade is only flagged when
          price, open interest and volume point the same way.
        </p>
        <div data-opai-animate data-delay="0.2" class="m3x-stack-cta">
          <a href="#pricing" class="magnetic-button w-full md:w-auto inline-block">
  <div class="group {=$class} relative z-10 w-full">
    <div
      class="{=$button-class} flex w-full cursor-pointer items-center justify-center gap-[7px] rounded-full bg-linear-[90deg,#DBE2E6_0%,#FFF_71.63%] px-6 py-[11px] md:py-[13px]"
    >
      <span
        class="font-ibm-plex-mono text-tagline-2 text-background-6 inline-block leading-[1.4] font-medium"
      >
        Try our platform
      </span>
      <span
        class="inline-block transition-transform duration-500 ease-in-out group-hover:translate-x-1"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
        >
          <path
            d="M6.75 13.5L11.25 9L6.75 4.5"
            stroke="#0D1017"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    </div>

    <!-- Gradient Circle-->
    <span
      class="magnetic-button-gradient {=$gradient-class} pointer-events-none absolute top-1/2 right-0 z-[-1] h-[56px] w-22 -translate-y-1/2 rounded-full bg-linear-[270deg,#5A9FFF_0%,rgba(255,250,107,0.20)_95.12%] blur-md transition-colors duration-500 ease-in-out content-['']"
    >
    </span>
    <!-- Gradient Circle-2-->
    <span
      class="magnetic-button-gradient {=$gradient-class} pointer-events-none absolute top-1/2 right-2 z-[-1] h-[60px] w-[82px] -translate-y-1/2 rounded-full bg-linear-[270deg,#5A9FFF_0%,rgba(255,250,107,0.20)_95.12%] blur-[7px] transition-colors duration-500 ease-in-out content-['']"
    >
    </span>
  </div>
</a>
        </div>
      </div>

      <!-- four data sources: cards stack on each other while scrolling (/js/stack.js scales the ones underneath) -->
      <ol class="m3x-stack-list" data-stack-cards aria-label="What every alert is built from">
        <li class="m3x-stack-item" style="--i: 0">
          <article class="m3x-stack-card">
            <div class="m3x-stack-top">
              <span class="ns-shape-1 m3x-stack-ico" aria-hidden="true"></span>
              <span class="m3x-stack-num">01<small>/04</small></span>
            </div>
            <div class="m3x-stack-body">
              <h3 class="m3x-stack-title">Price &amp; volume action.</h3>
              <p class="m3x-stack-text">Breakouts, trend strength, support and resistance, and volume spikes.</p>
            </div>
          </article>
        </li>
        <li class="m3x-stack-item" style="--i: 1">
          <article class="m3x-stack-card is-invert">
            <img loading="lazy" decoding="async" class="m3x-stack-glow" src="/images/gradient/opai-10-green.webp" alt="" aria-hidden="true" />
            <div class="m3x-stack-top">
              <span class="ns-shape-2 m3x-stack-ico" aria-hidden="true"></span>
              <span class="m3x-stack-num">02<small>/04</small></span>
            </div>
            <div class="m3x-stack-body">
              <h3 class="m3x-stack-title">Open interest &amp; PCR.</h3>
              <p class="m3x-stack-text">Call and put OI build-up, PCR shifts and key option chain levels.</p>
            </div>
          </article>
        </li>
        <li class="m3x-stack-item" style="--i: 2">
          <article class="m3x-stack-card">
            <div class="m3x-stack-top">
              <span class="ns-shape-3 m3x-stack-ico" aria-hidden="true"></span>
              <span class="m3x-stack-num">03<small>/04</small></span>
            </div>
            <div class="m3x-stack-body">
              <h3 class="m3x-stack-title">News &amp; events.</h3>
              <p class="m3x-stack-text">Company results, RBI policy and Indian economic data that move the market.</p>
            </div>
          </article>
        </li>
        <li class="m3x-stack-item" style="--i: 3">
          <article class="m3x-stack-card">
            <div class="m3x-stack-top">
              <span class="ns-shape-4 m3x-stack-ico" aria-hidden="true"></span>
              <span class="m3x-stack-num">04<small>/04</small></span>
            </div>
            <div class="m3x-stack-body">
              <h3 class="m3x-stack-title">Market breadth.</h3>
              <p class="m3x-stack-text">Advances and declines, sector moves and India VIX through every session.</p>
            </div>
          </article>
        </li>
      </ol>
    </div>
  </div>
</section>

<!--=============================== about =================================-->
<section class="m3x-sec m3x-pt-0 pb-17 md:pb-26 lg:pb-28 xl:pb-33 2xl:pb-39 pt-26 md:pt-30 lg:pt-36 xl:pt-40 2xl:pt-44 overflow-hidden">
  <div class="main-container space-y-17 md:space-y-26 lg:space-y-28 xl:space-y-33 2xl:space-y-39">
    <div class="grid grid-cols-12 gap-x-8 md:gap-x-10 lg:gap-x-12 2xl:gap-x-25">

      <div class="col-span-12 md:col-span-6 lg:col-span-8 space-y-8">

        <div class="m3x-block-head space-y-1.5 text-center lg:text-left lg:space-y-3">
          <h2 data-opai-word-slide-reveal
            class="xl:text-sora-heading-2 max-md:leading-[1.1] lg:text-sora-heading-3 text-sora-heading-4 font-normal text-white/90 xl:tracking-[-2.4px]">
            <span class="m3x-loss">Loss by guess.</span> <span class="text-mint m3x-line m3x-win">Win by data.</span>
          </h2>
          <p data-opai-word-slide-reveal data-delay="0.2" data-word-delay="0.04"
            class="text-tagline-2 font-inter-tight w-full font-normal text-white/60 lg:max-w-[620px]">
            Too many traders lose money acting on tips and gut feeling. Market360X replaces guesswork
            with alerts built on live market data, explained in plain language and delivered when it
            matters.
          </p>
        </div>

        <!-- Our Vision / Our Mission tabs (the About page's two lead paragraphs); /js/tabs.js -->
        <div class="m3x-vm" data-tabs data-opai-animate data-delay="0.2">
          <div class="m3x-vm-tabs" role="tablist" aria-label="Our vision and mission">
            <button type="button" class="m3x-vm-tab" role="tab" id="m3x-vm-tab-vision" aria-controls="m3x-vm-vision" aria-selected="true"><%- icon('eye') %>Our Vision</button>
            <button type="button" class="m3x-vm-tab" role="tab" id="m3x-vm-tab-mission" aria-controls="m3x-vm-mission" aria-selected="false" tabindex="-1"><%- icon('target') %>Our Mission</button>
          </div>
          <div class="m3x-vm-panels">
