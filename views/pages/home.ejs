<%- include('../partials/head') %>
<%- include('../partials/header') %>

    <main class="bg-background-6">
      <!-- ============================= Hero ============================= -->

<section class="m3x-hero4" aria-labelledby="m3x-hero4-title">
  <!-- full-bleed background video -->
  <div class="m3x-hero4-bg" aria-hidden="true">
    <video class="m3x-hero4-video" autoplay muted loop playsinline preload="metadata" poster="/videos/hero-trading-poster.webp">
      <source src="/videos/hero-trading.mp4" type="video/mp4" />
    </video>
    <span class="m3x-hero4-shade"></span>
  </div>
  <div class="main-container m3x-hero4-inner">
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position: absolute">
      <filter id="m3x-outline4" x="-5%" y="-10%" width="110%" height="130%">
        <feMorphology in="SourceGraphic" operator="dilate" radius="1.6" result="grown" />
        <feComposite in="grown" in2="SourceGraphic" operator="out" />
      </filter>
    </svg>
    <div class="m3x-hero4-copy">
      <h1 id="m3x-hero4-title" class="m3x-hero4-title">
        Alerts <br /><span class="m3x-hero4-outline">Backed By Data.</span>
      </h1>
      <div data-opai-animate data-delay="0.3" data-instant="true" class="m3x-hero4-cta">
<%- include('../partials/hero-cta') -%>
      </div>
    </div>
  </div>
</section>
<section class="m3x-sec m3x-stats3" aria-label="Why Market360X">
  <div class="main-container">
    <ul class="m3x-stats3-grid">
      <% [['zap', 'Real-time', 'Alerts every market session'], ['layers', '4 data checks', 'Price, OI, PCR and volume'], ['chart-candlestick', '5+', 'Markets covered'], ['send', 'Instant', 'Telegram &amp; WhatsApp delivery']].forEach(function (st, i) { %>
      <li class="m3x-stats3-card" data-opai-animate data-delay="<%= (0.1 + i * 0.1).toFixed(1) %>">
        <strong><%= st[1] %></strong>
        <span><%- st[2] %></span>
      </li>
      <% }) %>
    </ul>
  </div>
</section>
<section id="m3x-after-hero" class="m3x-sec relative">
  <div class="main-container">
    <div class="relative" data-opai-animate data-delay="0.2">
      <div class="m3x-sec-head m3x-dash-head">
        <h2 class="m3x-dash-title text-sora-heading-4 lg:text-sora-heading-3 font-normal text-white/90">Market Direction of the Day</h2>
      </div>
      <%- include('../partials/sentiment-dashboard') %>
    </div>
  </div>
</section>

      <!-- ============================= Integration ============================= -->

<section class="m3x-sec m3x-pt-0 bg-background-6 m3x-showcase" aria-labelledby="m3x-showcase-title" data-showcase style="--steps: 3">
  <!-- The section title scrolls normally (centred, one line); after it the slides pin while scrolling (desktop): the
       screenshot on the right changes with the scroll and the left shows its name (Dragger-Puller, Alert Engine,
       Interactive Candlestick Chart), one at a time. /js/showcase.js picks the step; phones show a column. -->
  <div class="main-container">
    <h2
      id="m3x-showcase-title"
      class="m3x-sc-heading xl:text-sora-heading-2 text-sora-heading-4 lg:text-sora-heading-3 font-normal text-white/90 xl:tracking-[-2.4px]"
    >
      One alert service. <span class="text-mint">Every market you trade.</span>
    </h2>
  </div>
  <div class="m3x-sc-track" data-showcase-track>
    <div class="m3x-sc-sticky">
      <div class="main-container m3x-sc-inner">
        <div class="m3x-sc-grid">
        <div class="m3x-sc-titles">
          <p class="m3x-sc-title is-active" data-showcase-title aria-hidden="true">Dragger-Puller</p>
          <p class="m3x-sc-title" data-showcase-title aria-hidden="true">Alert Engine</p>
          <p class="m3x-sc-title" data-showcase-title aria-hidden="true">Interactive Candlestick Chart</p>
        </div>

        <div class="m3x-sc-stage" aria-label="Market360X dashboard screenshots">
          <figure class="m3x-sc-shot is-active" data-showcase-slide>
            <div class="m3x-sc-frame"><img loading="lazy" decoding="async" src="/images/banners/banner1.webp" alt="Dragger-Puller view showing Nifty 50 stocks pulling and dragging the index" width="1280" height="719" /></div>
            <figcaption><span>Dragger-Puller</span><%- icon('arrow-right') %></figcaption>
          </figure>
          <figure class="m3x-sc-shot" data-showcase-slide>
            <div class="m3x-sc-frame"><img src="/images/banners/banner2.webp" alt="Alert Engine history log with re-entry and reversal alerts" width="1280" height="674" decoding="async" loading="lazy" /></div>
            <figcaption><span>Alert Engine</span><%- icon('arrow-right') %></figcaption>
          </figure>
          <figure class="m3x-sc-shot" data-showcase-slide>
            <div class="m3x-sc-frame"><img src="/images/banners/banner3.webp" alt="Real-time Nifty 50 candlestick chart with alert annotations" width="1280" height="718" decoding="async" loading="lazy" /></div>
            <figcaption><span>Interactive Candlestick Chart</span><%- icon('arrow-right') %></figcaption>
          </figure>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>

      <!-- ============================= Markets: index chart ============================= -->
<%- include('../partials/index-chart') %>

