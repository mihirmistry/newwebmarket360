<%- include('../partials/head') %>
<%- include('../partials/header') %>

    <main class="bg-background-6">
      <!--=============================== about =================================-->
<section class="m3x-sec m3x-sec--hero pb-17 md:pb-26 lg:pb-28 xl:pb-33 2xl:pb-39 pt-26 md:pt-30 lg:pt-36 xl:pt-40 2xl:pt-44 overflow-hidden">
  <div class="main-container space-y-17 md:space-y-26 lg:space-y-28 xl:space-y-33 2xl:space-y-39">
    <div class="md:space-y-15 space-y-8 lg:space-y-17.5">
      <div class="m3x-sec-head space-y-1.5 text-center lg:space-y-3">
        <h2 data-opai-word-slide-reveal
          class="xl:text-sora-heading-2 max-md:leading-[1.1] lg:text-sora-heading-3 text-sora-heading-4 font-normal text-white/90 xl:tracking-[-2.4px]">
          Accurate alerts for <span class="text-mint">every Indian trader</span>
        </h2>
      </div>
      <figure class="m3x-about-banner rounded-lg overflow-hidden w-full">
        <img src="/images/about-market-chart-1600.webp" srcset="/images/about-market-chart-640.webp 640w, /images/about-market-chart-1024.webp 1024w, /images/about-market-chart-1600.webp 1600w" sizes="(min-width: 1400px) 1300px, 100vw" alt="Rising candlestick chart on a trading screen" class="size-full object-cover" width="1600" height="1067" fetchpriority="high">
      </figure>
    </div>


    <div class="grid grid-cols-12 gap-x-8 md:gap-x-10 lg:gap-x-12 2xl:gap-x-25">

      <div class="col-span-12 md:col-span-6 lg:col-span-8 space-y-8">

        <div class="space-y-1.5 text-center lg:text-left lg:space-y-3">
          <h2 data-opai-word-slide-reveal
            class="xl:text-sora-heading-2 max-md:leading-[1.1] lg:text-sora-heading-3 text-sora-heading-4 font-normal text-white/90 xl:tracking-[-2.4px]">
            How Market360X <span class="text-mint">was born</span>
          </h2>
          <p data-opai-word-slide-reveal data-delay="0.2" data-word-delay="0.04"
            class="text-tagline-2 font-inter-tight w-full font-normal text-white/60 lg:max-w-[620px]">
            Market360X started with a simple frustration: too many traders were acting on tips, rumours and gut feeling, while the data that really moves the market, like price action, open interest and the option chain, was hard to read in time. We built Market360X to watch that data for you and turn it into clear alerts for Nifty, Sensex, Bank Nifty and options, each showing the direction and the data behind it.
          </p>
        </div>

        <div class="flex flex-col md:flex-row gap-3">
          <div class="space-y-3 md:w-[51%]">

            <div data-opai-animate data-delay="0.2"
              class="bg-background-4 flex flex-row md:flex-col lg:flex-row items-center gap-y-2 gap-x-3 justify-start rounded-lg p-6 md:p-8">
              <h3
                class="text-sora-heading-5 inline-flex items-baseline font-normal tracking-[-0.72px] text-white/90"
                data-counter-trigger
                data-counter-value="6"
                data-counter-duration="1.8"
              >
                <number-flow data-counter-number></number-flow>
              </h3>
              <p class="text-tagline-2 font-inter-tight text-white/80">
                Indian indices tracked live, from Nifty to Bankex
              </p>
            </div>
            <!-- branding card -->
            <div data-opai-animate data-delay="0.3"
              class="bg-background-4 relative overflow-hidden rounded-lg p-6 md:p-8">
              <div
                class="ease-team-ease-1 absolute -top-[64%] -left-[13%] -z-0 size-37 bg-white mix-blend-plus-lighter blur-[25.5px]">
              </div>
              <div class="bg-opai-blue ease-team-ease-1 absolute -top-[48%] -left-[9%] -z-0 size-34 blur-[42px]"></div>

              <div class="relative z-10 space-y-3">
                <h3 class="text-sora-heading-5 font-normal tracking-[-0.72px] text-white/90">
                  Signal over noise
                </h3>
                <p class="text-tagline-3 font-inter-tight text-white/60 max-w-[280px]">
                  Fewer, higher-conviction setups instead of a flood of alerts you can't act on.
                </p>
              </div>
            </div>
          </div>

          <div class="space-y-3 md:w-[49%]">
            <!-- Website design card -->
            <div data-opai-animate data-delay="0.3" class="bg-background-4 rounded-lg p-6 md:p-7.5">


              <div class="space-y-3">
                <h3 class="text-sora-heading-5 font-normal tracking-[-0.72px] text-white/90">
                  Transparent by design
                </h3>
                <p class="text-tagline-3 font-inter-tight text-white/60 max-w-[280px]">
                  Every alert shows the direction, the signal strength and the reason behind it.
                </p>
              </div>
            </div>

            <div data-opai-animate data-delay="0.2"
              class="bg-background-4 flex flex-row  md:flex-col lg:flex-row items-center gap-y-2 gap-x-4 justify-start rounded-lg p-6 md:p-7.5">
              <!-- Avatars and Trust Indicator -->
              <div class="flex -space-x-2.5">
                <img data-opai-avatar data-avatar-delay="0.2"
                  class="inline-block shrink-0 size-9 rounded-full ring-2 ring-white"
                  src="/images/opai-avatar-img-01.png" alt="Avatar 1" />
                <img data-opai-avatar data-avatar-delay="0.3"
                  class="inline-block shrink-0 size-9 rounded-full ring-2 ring-white"
                  src="/images/opai-avatar-img-02.png" alt="Avatar 2" />
                <img data-opai-avatar data-avatar-delay="0.4"
                  class="inline-block shrink-0 size-9 rounded-full ring-2 ring-white"
                  src="/images/opai-avatar-img-03.png" alt="Avatar 3" />

                <div data-opai-avatar data-avatar-delay="0.6"
                  class="text-tagline-4 inline-flex shrink-0 size-9 items-center justify-center rounded-full bg-[#0d0d1280] font-medium text-white/80 ring-2 ring-white backdrop-blur-[6px]">
                  99+
                </div>
              </div>
              <p class="text-tagline-3 font-inter-tight text-white/60 inline">
                Built by traders,
                for traders.
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-span-12 md:col-span-6 max-md:mt-8 lg:col-span-4" data-opai-animate data-delay="0.3"
        data-direction="right">

        <figure class="rounded-lg overflow-hidden w-full h-full ">
          <img src="/images/trading-tablet.webp" alt="Trader checking market charts on a tablet" class="size-full object-cover" width="733" height="683">
        </figure>
      </div>
    </div>
  </div>
</section>
      <!-- =============================== vision & objectives (content: Motive.docx) ================================== -->
<section class="m3x-sec m3x-pt-0 m3x-motive" aria-labelledby="m3x-vision-title">
  <div class="main-container">
    <div class="m3x-motive-head" data-opai-animate data-delay="0.1">
      <ul class="m3x-motive-pills" aria-label="What Market360X stands for">
        <li><%- icon('shield-check') %>Protect Capital</li>
        <li><%- icon('database') %>Trust Data</li>
        <li><%- icon('scale') %>Manage Risk</li>
        <li><%- icon('sprout') %>Grow with Discipline</li>
      </ul>
      <h2 id="m3x-vision-title" class="m3x-motive-title">Our <span class="text-mint">Vision</span></h2>
      <p class="m3x-motive-lead">To empower retail traders with financial knowledge, advanced market analytics and disciplined risk management, guided by three fundamental objectives.</p>
    </div>

    <ol class="m3x-objectives">
      <li class="m3x-objective" data-opai-animate data-delay="0.2" style="--bg: url('/images/about/objective-1.webp')">
        <div class="m3x-objective-panel">
          <p class="m3x-objective-num">Objective 1</p>
          <h3>Reduce Retail Trading Losses</h3>
          <p>Our long-term ambition is to contribute towards reducing the proportion of loss-making retail F&amp;O traders from approximately <strong>90% to 80%</strong><a class="m3x-objective-note" href="#m3x-motive-disclaimer" aria-label="See disclaimer">*</a> through informed decision-making, market understanding and effective risk management.</p>
          <blockquote class="m3x-objective-quote"><%- icon('quote') %>Save retail traders from Losses.</blockquote>
        </div>
      </li>
      <li class="m3x-objective" data-opai-animate data-delay="0.3" style="--bg: url('/images/about/objective-2.webp')">
        <div class="m3x-objective-panel">
          <p class="m3x-objective-num">Objective 2</p>
          <h3>Capital Protection First, Profits Will Follow</h3>
          <p>Our priority is to encourage retail traders to protect their trading capital before pursuing profits.</p>
          <p>We believe that preserving capital, controlling losses and maintaining trading discipline create a strong foundation for long-term financial success.</p>
          <blockquote class="m3x-objective-quote"><%- icon('quote') %>First Protect Your Capital. Focus on Profits Later.</blockquote>
        </div>
      </li>
      <li class="m3x-objective" data-opai-animate data-delay="0.4" style="--bg: url('/images/about/objective-3.webp')">
        <div class="m3x-objective-panel">
          <p class="m3x-objective-num">Objective 3</p>
          <h3>Win by Data, Not by Guesswork</h3>
          <p>We believe successful trading decisions should be driven by reliable market data, disciplined analysis and a clearly defined strategy rather than assumptions, emotions or speculation.</p>
          <p>Market360X aims to empower retail traders to replace guesswork with data-driven decision-making through advanced analytical tools and market insights.</p>
          <blockquote class="m3x-objective-quote"><%- icon('quote') %>Win by Data, Not by Guesswork.</blockquote>
        </div>
      </li>
    </ol>

    <div class="m3x-philosophy" data-opai-animate data-delay="0.2">
      <p class="m3x-philosophy-label">Our philosophy is simple:</p>
      <ol class="m3x-philosophy-steps">
        <li class="m3x-philo-card"><span class="m3x-philo-num" aria-hidden="true">01</span><span class="m3x-philo-ico" aria-hidden="true"><%- icon('chart-column-increasing') %></span><span class="m3x-philo-title"><span class="sr-only">Step 1: </span>Analyse with Data</span></li>
        <li class="m3x-philo-card"><span class="m3x-philo-num" aria-hidden="true">02</span><span class="m3x-philo-ico" aria-hidden="true"><%- icon('target') %></span><span class="m3x-philo-title"><span class="sr-only">Step 2: </span>Decide with Discipline</span></li>
        <li class="m3x-philo-card"><span class="m3x-philo-num" aria-hidden="true">03</span><span class="m3x-philo-ico" aria-hidden="true"><%- icon('scale') %></span><span class="m3x-philo-title"><span class="sr-only">Step 3: </span>Manage Risk</span></li>
        <li class="m3x-philo-card"><span class="m3x-philo-num" aria-hidden="true">04</span><span class="m3x-philo-ico" aria-hidden="true"><%- icon('shield-check') %></span><span class="m3x-philo-title"><span class="sr-only">Step 4: </span>Protect Capital</span></li>
      </ol>
    </div>
  </div>
</section>

      <!-- =============================== mission ================================== -->
<section class="m3x-sec m3x-pt-0 m3x-motive" aria-labelledby="m3x-mission-title">
  <div class="main-container m3x-mission">
    <div class="m3x-mission-copy" data-opai-animate data-delay="0.1">
      <h2 id="m3x-mission-title" class="m3x-motive-title">Our <span class="text-mint">Mission</span></h2>
      <p class="m3x-motive-lead">Market360X aims to make financial market information accessible, understandable and actionable through advanced market analytics, including Option Chain, Open Interest (OI), Put-Call Ratio (PCR), technical indicators, intelligent alerts and risk-management tools.</p>
    </div>
    <div class="m3x-mission-card" data-opai-animate data-delay="0.2">
      <h3>Our mission is to help retail traders:</h3>
      <ul class="m3x-mission-list">
        <li><%- icon('circle-check') %>Reduce avoidable trading losses.</li>
        <li><%- icon('circle-check') %>Prioritise capital preservation over speculative profits.</li>
        <li><%- icon('circle-check') %>Replace emotional decisions and guesswork with data-driven analysis.</li>
        <li><%- icon('circle-check') %>Improve trading discipline and risk management.</li>
        <li><%- icon('circle-check') %>Develop responsible and sustainable trading practices.</li>
      </ul>
    </div>
  </div>
</section>

      <!-- =============================== commitment ================================== -->
<section class="m3x-sec m3x-pt-0 m3x-motive" aria-labelledby="m3x-commitment-title">
  <div class="main-container">
    <div class="m3x-motive-head" data-opai-animate data-delay="0.1">
      <h2 id="m3x-commitment-title" class="m3x-motive-title">Our <span class="text-mint">Commitment</span></h2>
    </div>
    <ul class="m3x-commitments" data-opai-animate data-delay="0.2">
      <li><span class="m3x-objective-icon"><%- icon('info') %></span>Better Information</li>
      <li><span class="m3x-objective-icon"><%- icon('chart-line') %></span>Better Analysis</li>
      <li><span class="m3x-objective-icon"><%- icon('target') %></span>Better Discipline</li>
      <li><span class="m3x-objective-icon"><%- icon('shield') %></span>Better Risk Management</li>
    </ul>
    <div class="m3x-principles" data-opai-animate data-delay="0.3">
      <p class="m3x-philosophy-label">We stand for three principles:</p>
      <p class="m3x-principles-line"><span>Reduce Losses.</span> <span>Protect Capital.</span> <span class="text-mint">Trust Data.</span></p>
    </div>

    <aside class="m3x-motive-disclaimer" id="m3x-motive-disclaimer" aria-labelledby="m3x-motive-disclaimer-title">
      <p class="m3x-motive-disclaimer-title" id="m3x-motive-disclaimer-title"><%- icon('triangle-alert') %>Disclaimer – SEBI Non-Registration</p>
      <p>Market360X is not registered with the Securities and Exchange Board of India (SEBI) as an Investment Adviser or Research Analyst.</p>
      <p>Market360X provides market analytics, technical indicators and educational information for general informational purposes only. Its tools and alerts do not constitute personalised investment advice or recommendations to buy, sell or hold securities.</p>
      <p>Trading and investing, particularly in futures and options, involve substantial financial risk.</p>
      <p>Market360X does not guarantee trading profits, capital protection, successful outcomes from data analysis or any reduction in financial losses. The stated loss-reduction target is aspirational and not an assured or demonstrated result.</p>
    </aside>
  </div>
</section>
      <!-- ============================= Closing CTA ============================= -->
<%- include('../partials/cta-band') %>

    </main>

<%- include('../partials/footer') %>
