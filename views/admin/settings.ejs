<%- include('_shell', { title: 'Settings', adminPage: 'settings' }) %>
<% const invalid = function (f) { return errors[f] ? ' aria-invalid="true"' : ''; }; %>
    <div class="adm-page-head">
      <h1>Settings</h1>
      <p class="adm-muted">Choose where new orders and Contact page messages are emailed, how the website sends email, and the Angel One account that feeds the automatic indicators.</p>
    </div>

    <% if (flash) { %><p class="adm-alert is-<%= flash.type %>" role="status"><%= flash.message %></p><% } %>

    <%# tabs (/js/admin-tabs.js); a form that comes back with errors or a test result opens on its own tab %>
    <div class="adm-tabs" role="tablist" aria-label="Settings" data-adm-tabs data-active="<%= Object.keys(angel.errors).length || angel.test ? 'tab-angel' : 'tab-mail' %>">
      <button type="button" class="adm-tab" role="tab" id="tab-mail" aria-controls="panel-mail" aria-selected="true" data-hash="notifications"><%- icon('bell') %>Notifications</button>
      <button type="button" class="adm-tab" role="tab" id="tab-angel" aria-controls="panel-angel" aria-selected="false" data-hash="set-angel" tabindex="-1"><%- icon('plug') %>Angel One API</button>
    </div>

    <div class="adm-tab-panel" role="tabpanel" id="panel-mail" aria-labelledby="tab-mail">
    <span id="notifications"></span>
    <% if (testError) { %><p class="adm-alert is-error" role="alert"><strong>The test email could not be sent.</strong> <%= testError %></p><% } %>
    <% if (Object.keys(errors).length) { %><p class="adm-alert is-error" role="alert">Please fix the highlighted fields.</p><% } %>
    <% if (mail.source === 'env') { %><p class="adm-alert is-info">Email currently uses the SMTP details from the server's .env file. Saving here replaces them.</p><% } %>
    <% if (mail.passwordUnreadable) { %><p class="adm-alert is-error">The saved SMTP password can no longer be read (the server's secret key changed). Please enter it again.</p><% } %>

    <form method="post" action="/admin/settings" class="adm-settings" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <section class="adm-card" aria-labelledby="set-recipients">
        <div class="adm-card-head">
          <div>
            <h2 id="set-recipients">Notification emails</h2>
            <p class="adm-muted adm-small">Who gets an email when something new comes in.</p>
          </div>
        </div>
        <label class="adm-field">
          <span>Send notifications to</span>
          <input type="text" name="recipients" value="<%= values.recipients %>" placeholder="you@market360x.com, team@market360x.com" autocomplete="off"<%- invalid('recipients') %> aria-describedby="hint-recipients" />
          <small class="adm-hint" id="hint-recipients">One or more addresses (up to 5), separated by commas.</small>
          <% if (errors.recipients) { %><small class="adm-error"><%= errors.recipients %></small><% } %>
        </label>
        <div class="adm-checks">
          <label class="adm-check"><input type="checkbox" name="notifyOrders"<%- values.notifyOrders ? ' checked' : '' %> /><span><strong>New orders</strong><small>Customer details and UPI reference from the QR checkout</small></span></label>
          <label class="adm-check"><input type="checkbox" name="notifyMessages"<%- values.notifyMessages ? ' checked' : '' %> /><span><strong>New Contact page messages</strong><small>Reply straight from your inbox</small></span></label>
        </div>
      </section>

      <section class="adm-card" aria-labelledby="set-smtp">
        <div class="adm-card-head">
          <div>
            <h2 id="set-smtp">SMTP server</h2>
            <p class="adm-muted adm-small">The mail account the website sends from. For Gmail use smtp.gmail.com, port 465, SSL, and an App Password.</p>
          </div>
          <% if (updatedAt) { %><span class="adm-muted adm-small">Last saved <%= updatedAt %></span><% } %>
        </div>
        <div class="adm-fields">
          <label class="adm-field is-wide">
            <span>SMTP server</span>
            <input type="text" name="host" value="<%= values.host %>" placeholder="smtp.gmail.com" autocomplete="off" spellcheck="false"<%- invalid('host') %> />
            <% if (errors.host) { %><small class="adm-error"><%= errors.host %></small><% } %>
          </label>
          <label class="adm-field">
            <span>Port</span>
            <input type="number" name="port" value="<%= values.port %>" min="1" max="65535" inputmode="numeric"<%- invalid('port') %> />
            <% if (errors.port) { %><small class="adm-error"><%= errors.port %></small><% } %>
          </label>
          <label class="adm-field">
            <span>Security</span>
            <select name="security"<%- invalid('security') %>>
              <option value="starttls"<%- values.security === 'starttls' ? ' selected' : '' %>>STARTTLS (usually port 587)</option>
              <option value="ssl"<%- values.security === 'ssl' ? ' selected' : '' %>>SSL/TLS (usually port 465)</option>
              <option value="none"<%- values.security === 'none' ? ' selected' : '' %>>None (not recommended)</option>
            </select>
            <% if (errors.security) { %><small class="adm-error"><%= errors.security %></small><% } %>
          </label>
          <label class="adm-field">
            <span>Username</span>
            <input type="text" name="user" value="<%= values.user %>" placeholder="you@gmail.com" autocomplete="off" spellcheck="false"<%- invalid('user') %> />
          </label>
          <div class="adm-field">
            <label for="set-password">Password</label>
            <input type="password" id="set-password" name="password" value="" autocomplete="new-password" placeholder="<%= hasPassword ? 'Saved. Leave blank to keep it' : 'SMTP or app password' %>" aria-describedby="hint-password" />
            <small class="adm-hint" id="hint-password">Stored encrypted. <%= hasPassword ? 'Leave blank to keep the saved password.' : '' %></small>
            <% if (hasPassword) { %><label class="adm-check is-inline"><input type="checkbox" name="clearPassword" /><span>Remove the saved password</span></label><% } %>
          </div>
          <label class="adm-field">
            <span>From name</span>
            <input type="text" name="fromName" value="<%= values.fromName %>" placeholder="Market360X" maxlength="80" />
          </label>
          <label class="adm-field">
            <span>From email <em class="adm-optional">(optional)</em></span>
            <input type="email" name="fromEmail" value="<%= values.fromEmail %>" placeholder="Defaults to the username"<%- invalid('fromEmail') %> />
            <% if (errors.fromEmail) { %><small class="adm-error"><%= errors.fromEmail %></small><% } %>
          </label>
        </div>
      </section>

      <div class="adm-actions adm-settings-actions">
        <button type="submit" class="adm-btn is-primary"><%- icon('check') %>Save settings</button>
        <button type="submit" class="adm-btn" formaction="/admin/settings/test" formnovalidate<%- mail.configured ? '' : ' disabled' %>><%- icon('send') %>Send test email</button>
        <span class="adm-muted adm-small"><%= mail.configured ? 'The test uses the saved settings. Save first if you changed anything.' : 'Save your settings, then send a test email.' %></span>
      </div>
    </form>

    </div>

    <div class="adm-tab-panel" role="tabpanel" id="panel-angel" aria-labelledby="tab-angel">
    <!-- Angel One SmartAPI: automatic indicators (src/services/auto-indicators.ts) -->
    <% const ae = angel.errors; const ainv = function (f) { return ae[f] ? ' aria-invalid="true"' : ''; }; %>
    <form method="post" action="/admin/settings/angelone" class="adm-settings" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <section class="adm-card" aria-labelledby="set-angel-title" id="set-angel">
        <div class="adm-card-head">
          <div>
            <h2 id="set-angel-title">Angel One SmartAPI <span class="adm-sr">(automatic indicators)</span></h2>
            <p class="adm-muted adm-small">
              Automatic indicators on the Nifty alerts page are calculated from Angel One market data: every 15 minutes
              during market hours and once after the close. Requests must come from the static IP registered on your SmartAPI app.
            </p>
          </div>
          <% if (angel.savedAt) { %><span class="adm-muted adm-small">Last saved <%= angel.savedAt %></span><% } %>
        </div>
        <% if (angel.test) { %><p class="adm-alert is-<%= angel.test.ok ? 'success' : 'error' %>" role="<%= angel.test.ok ? 'status' : 'alert' %>"><% if (!angel.test.ok) { %><strong>Couldn't connect.</strong> <% } %><%= angel.test.message %></p><% } %>
        <% if (ae.angel) { %><p class="adm-alert is-error" role="alert"><%= ae.angel %></p><% } %>
        <% if (angel.lastResult) { %><p class="adm-alert is-<%= angel.lastResult.ok ? 'info' : 'error' %>">Last update: <%= angel.lastResult.message %></p><% } else if (angel.lastUpdate) { %><p class="adm-muted adm-small">Indicators last updated <%= angel.lastUpdate %>.</p><% } %>
        <div class="adm-fields">
          <label class="adm-field">
            <span>Client code</span>
            <input type="text" name="clientCode" value="<%= angel.clientCode %>" placeholder="e.g. A123456" autocomplete="off" spellcheck="false"<%- ainv('clientCode') %> />
            <% if (ae.clientCode) { %><small class="adm-error"><%= ae.clientCode %></small><% } %>
          </label>
          <label class="adm-field">
            <span>PIN</span>
            <input type="password" name="pin" value="" inputmode="numeric" autocomplete="new-password" placeholder="<%= angel.hasPin ? 'Saved. Leave blank to keep it' : 'Your 4-digit MPIN' %>"<%- ainv('pin') %> />
            <% if (ae.pin) { %><small class="adm-error"><%= ae.pin %></small><% } %>
          </label>
          <label class="adm-field is-wide">
            <span>API key</span>
            <input type="password" name="apiKey" value="" autocomplete="new-password" placeholder="<%= angel.hasApiKey ? 'Saved. Leave blank to keep it' : 'From your SmartAPI app' %>"<%- ainv('apiKey') %> />
            <% if (ae.apiKey) { %><small class="adm-error"><%= ae.apiKey %></small><% } %>
          </label>
          <label class="adm-field is-wide">
            <span>TOTP secret</span>
            <input type="password" name="totpSecret" value="" autocomplete="new-password" spellcheck="false" placeholder="<%= angel.hasTotp ? 'Saved. Leave blank to keep it' : 'The text shown under the TOTP QR code' %>"<%- ainv('totpSecret') %> aria-describedby="hint-totp" />
            <small class="adm-hint" id="hint-totp">API key, PIN and TOTP secret are stored encrypted and never shown again.</small>
            <% if (ae.totpSecret) { %><small class="adm-error"><%= ae.totpSecret %></small><% } %>
          </label>
        </div>
        <div class="adm-checks">
          <label class="adm-check"><input type="checkbox" name="enabled"<%- angel.enabled ? ' checked' : '' %> /><span><strong>Update indicators automatically</strong><small>Every 15 minutes from 9:15 AM to 3:35 PM IST on weekdays, plus a final update after the close</small></span></label>
        </div>
      </section>
      <div class="adm-actions adm-settings-actions">
        <button type="submit" class="adm-btn is-primary"><%- icon('check') %>Save Angel One details</button>
        <button type="submit" class="adm-btn" formaction="/admin/settings/angelone/test" formnovalidate<%- angel.hasApiKey && angel.hasPin && angel.hasTotp ? '' : ' disabled' %>><%- icon('send') %>Test connection</button>
        <span class="adm-muted adm-small">The test logs in and reads the Nifty 50 price using the saved details.</span>
      </div>
    </form>
    </div>
<%- include('_shell-end', { pageScripts: ['/js/admin-tabs.js'] }) %>
